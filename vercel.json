{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "dashboard.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/get-devices",
      "dest": "app.py"
    },
    {
      "src": "/(.*)",
      "dest": "dashboard.py"
    }
  ]
}
